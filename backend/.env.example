# ===================================================================
# SMART CRASH & TRAFFIC MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ===================================================================

# Database Credentials
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_traffic

# TomTom Traffic API Configuration
# Get your free API key at: https://developer.tomtom.com/
# 1. Register a free account at developer.tomtom.com
# 2. Go to "My Dashboard" -> "Keys" -> copy your Consumer Key
# 3. Paste it below (do NOT commit this file to public git repositories)
TOMTOM_API_KEY=PASTE_YOUR_REAL_KEY_HERE

# Google Maps Platform API Configuration (Optional)
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Enable "Maps JavaScript API" and "Directions API" in APIs & Services
# 3. Under Credentials, create/select your API Key
# 4. Restrict key by Application (HTTP Referrers):
#    - http://localhost:3000/*
#    - http://127.0.0.1:3000/*
# 5. Restrict key by API: select "Maps JavaScript API" and "Directions API"
# 6. Paste your key below:
GOOGLE_MAPS_API_KEY=PASTE_YOUR_GOOGLE_MAPS_API_KEY_HERE

